# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# Todo lo que empiece con VITE_ queda EMBEBIDO en el bundle del cliente.
# Nunca pongas aqui la `service_role` key de Supabase: esa solo vive en el
# servidor (Edge Functions), como secreto del proyecto.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Panel de Supabase -> Project Settings -> Data API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Web Push (notificaciones en el iPhone con la app cerrada) -------------
# Genera el par de llaves con:  pnpm keys:vapid
# La publica va aqui; la privada se guarda como secreto en Supabase.
VITE_VAPID_PUBLIC_KEY=

# --- Comportamiento de la app ---------------------------------------------
# 'true' escribe trazas del motor de sincronizacion en la consola.
VITE_DEBUG_SYNC=false

# Minutos entre reconciliaciones completas contra el servidor.
VITE_SYNC_INTERVAL_MINUTES=5

# Ruta base publica del build web (GitHub Pages usa /<repo>/).
VITE_PUBLIC_BASE=/
